{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lin Flow Next",
  "version": "0.1.0",
  "identifier": "com.johnlin.linflow.next",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/Lin Flow Next/recordings/**", "$HOME/Library/Application Support/Lin Flow Next/recordings/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "category": "Productivity",
    "shortDescription": "Hold a key, talk, and the words appear where you type.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "14.2"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
